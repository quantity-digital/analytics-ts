{
  "name": "@quantity-digital/analytics-ts",
  "version": "1.0.2",
  "description": "Simple dataLayer analytics wrapper",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quantity-digital/analytics-ts.git"
  },
  "homepage": "https://github.com/quantity-digital/analytics-ts#readme",
  "bugs": {
